---
import { Icon } from 'astro-icon/components';
import DocLayout from '../layouts/DocLayout.astro';
import { resourceLinks, site } from '../data/site';

const toc = [
  { label: '文档与社区', href: '#链接' },
  { label: '安装包', href: '#安装包' },
  { label: '研究与基准', href: '#研究与基准' },
  { label: '贡献', href: '#贡献' },
  { label: '许可证', href: '#许可证' },
] as const;
const packages = [
  { name: 'hindsight-api', text: 'PyPI', href: 'https://pypi.org/project/hindsight-api/' },
  { name: 'hindsight-client', text: 'PyPI', href: 'https://pypi.org/project/hindsight-client/' },
  { name: '@vectorize-io/hindsight-client', text: 'npm', href: 'https://www.npmjs.com/package/@vectorize-io/hindsight-client' },
  { name: 'hindsight-clients/go', text: 'Go', href: 'https://github.com/vectorize-io/hindsight' },
] as const;
---

<DocLayout
  title="资源"
  eyebrow="Resources"
  toc={toc}
  lead="官方文档、SDK 参考、论文与基准看板都在这里；社区入口包括 Slack 与 GitHub Issues。项目以 MIT 许可开源。"
>
  <Fragment slot="header">
    <ul role="list" class="mt-9 flex flex-wrap gap-2 xl:hidden">
      {
        toc.map((item) => (
          <li>
            <a
              href={item.href}
              class="inline-flex rounded-sm border border-line px-3 py-1.5 text-[13.5px] text-fg-muted transition-colors duration-200 hover:border-line-strong hover:text-fg"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </Fragment>

  <h2 id="链接">文档与社区</h2>

  <div class="mt-6 grid gap-4 sm:grid-cols-3">
    {
      resourceLinks.map((group) => (
        <section class="rounded-lg border border-line bg-bg p-5">
          <h3 class="!m-0 !text-[15.5px] font-semibold">{group.group}</h3>
          <ul role="list" class="!mt-4 grid gap-2.5">
            {group.items.map((item) => (
              <li class="!mt-0 !pl-0 before:hidden">
                <a
                  href={item.href}
                  target="_blank"
                  rel="noreferrer noopener"
                  class="group flex items-center justify-between gap-2 text-[14.5px] text-fg-muted no-underline transition-colors duration-200 hover:text-fg"
                >
                  {item.name}
                  <Icon
                    name="tabler:arrow-up-right"
                    class="size-3.5 shrink-0 text-fg-subtle opacity-0 transition-opacity duration-200 group-hover:opacity-100"
                    aria-hidden="true"
                  />
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>

  <h2 id="安装包">安装包</h2>

  <div class="mt-4 grid gap-px overflow-hidden rounded-lg border border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
    {
      packages.map((pkg) => (
        <a
          href={pkg.href}
          target="_blank"
          rel="noreferrer noopener"
          class="group bg-bg p-4 transition-colors duration-200 hover:bg-bg-elev"
        >
          <span class="font-mono text-[11.5px] tracking-[0.14em] text-fg-subtle uppercase">
            {pkg.text}
          </span>
          <span class="mt-2 block font-mono text-[13.5px] break-all text-fg transition-colors duration-200 group-hover:text-accent">
            {pkg.name}
          </span>
        </a>
      ))
    }
  </div>

  <h2 id="研究与基准">研究与基准</h2>

  <p>
    Hindsight 在 LongMemEval 上取得 94.6% 的综合得分。实时、持续更新的结果（包括各模型的准确率、延迟与成本）发布在
    <a href={site.benchmarks} target="_blank" rel="noreferrer noopener">基准看板</a>；方法与实验细节见
    <a href={site.paper} target="_blank" rel="noreferrer noopener">论文</a>。
  </p>

  <p>
    基准数据已由弗吉尼亚理工 Sanghani 人工智能与数据分析中心以及《华盛顿邮报》的研究合作方独立复现；其余分数由各家软件厂商自行上报。
  </p>

  <h2 id="贡献">贡献</h2>

  <p>
    贡献指南见仓库中的{' '}
    <a
      href="https://github.com/vectorize-io/hindsight/blob/main/CONTRIBUTING.md"
      target="_blank"
      rel="noreferrer noopener">CONTRIBUTING.md</a>。有问题或建议，先到{' '}
    <a href={site.slack} target="_blank" rel="noreferrer noopener">Slack</a> 聊一聊，或开一个{' '}
    <a
      href="https://github.com/vectorize-io/hindsight/issues"
      target="_blank"
      rel="noreferrer noopener">GitHub Issue</a>。
  </p>

  <h2 id="许可证">许可证</h2>

  <p>
    MIT 许可，详见仓库中的{' '}
    <a
      href="https://github.com/vectorize-io/hindsight/blob/main/LICENSE"
      target="_blank"
      rel="noreferrer noopener">LICENSE</a>。由{' '}
    <a href="https://vectorize.io" target="_blank" rel="noreferrer noopener">Vectorize.io</a> 构建。
  </p>

  <Fragment slot="after">
    <div class="mt-10 flex flex-wrap gap-3 border-t border-line pt-10">
      <a
        href={site.github}
        target="_blank"
        rel="noreferrer noopener"
        class="inline-flex items-center gap-2 rounded-md bg-accent px-5 py-3 text-[15px] font-medium text-accent-fg transition-[transform,background-color] duration-200 hover:bg-accent-strong active:translate-y-px"
      >
        <Icon name="tabler:brand-github" class="size-4" aria-hidden="true" />
        Star 仓库
      </a>
      <a
        href="https://www.star-history.com/vectorize-io/hindsight"
        target="_blank"
        rel="noreferrer noopener"
        class="inline-flex items-center gap-2 rounded-md border border-line px-5 py-3 text-[15px] text-fg transition-colors duration-200 hover:border-line-strong active:translate-y-px"
      >
        <Icon name="tabler:star" class="size-4" aria-hidden="true" />
        Star 历史
      </a>
    </div>
  </Fragment>
</DocLayout>
