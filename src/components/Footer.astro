---
import { Icon } from 'astro-icon/components';
import Logo from './Logo.astro';
import { nav, resourceLinks, site } from '../data/site';

const year = new Date().getFullYear();
const columns = [
  { name: '文档', items: resourceLinks[0].items },
  { name: '客户端', items: resourceLinks[1].items },
  { name: '研究', items: resourceLinks[2].items },
];
---

<footer class="border-t border-line bg-bg-sunken">
  <div class="shell pt-16 pb-10 lg:pt-20">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-[1.1fr_2fr]">
      <div class="max-w-sm">
        <Logo size="sm" />
        <p class="mt-5 text-[15px] leading-[1.9] text-fg-muted">
          智能体记忆系统。不只回放对话历史，而是让智能体随时间真正学会。
        </p>
        <div class="mt-7 flex items-center gap-2">
          <a
            href={site.github}
            target="_blank"
            rel="noreferrer noopener"
            class="grid size-9 place-items-center rounded-sm border border-line text-fg-muted transition-colors duration-200 hover:border-line-strong hover:text-fg"
            aria-label="GitHub 仓库"
          >
            <Icon name="tabler:brand-github" class="size-4.5" aria-hidden="true" />
          </a>
          <a
            href={site.slack}
            target="_blank"
            rel="noreferrer noopener"
            class="grid size-9 place-items-center rounded-sm border border-line text-fg-muted transition-colors duration-200 hover:border-line-strong hover:text-fg"
            aria-label="Slack 社区"
          >
            <Icon name="tabler:brand-slack" class="size-4.5" aria-hidden="true" />
          </a>
          <a
            href={site.paper}
            target="_blank"
            rel="noreferrer noopener"
            class="grid size-9 place-items-center rounded-sm border border-line text-fg-muted transition-colors duration-200 hover:border-line-strong hover:text-fg"
            aria-label="论文"
          >
            <Icon name="tabler:file-text" class="size-4.5" aria-hidden="true" />
          </a>
        </div>
      </div>

      <div class="grid gap-10 sm:grid-cols-3">
        {
          columns.map((column) => (
            <div>
              <h2 class="font-mono text-[10.5px] tracking-[0.2em] text-fg-subtle uppercase">
                {column.name}
              </h2>
              <ul class="mt-5 grid gap-2.5">
                {column.items.map((item) => (
                  <li>
                    <a
                      href={item.href}
                      target="_blank"
                      rel="noreferrer noopener"
                      class="sweep text-[14.5px] text-fg-muted transition-colors duration-200 hover:text-fg"
                    >
                      {item.name}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <div
      class="mt-14 flex flex-col gap-4 border-t border-line pt-8 text-[13.5px] text-fg-subtle sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {year} Hindsight，由 Vectorize.io 构建，MIT 许可</p>
      <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
        <nav aria-label="站点导航">
          <ul class="flex flex-wrap items-center gap-x-5 gap-y-2">
            {
              nav.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="transition-colors duration-200 hover:text-fg"
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <a
          href="#main"
          class="inline-flex items-center gap-1.5 transition-colors duration-200 hover:text-fg"
        >
          <Icon name="tabler:arrow-up" class="size-3.5" aria-hidden="true" />
          回到顶部
        </a>
      </div>
    </div>
  </div>
</footer>
