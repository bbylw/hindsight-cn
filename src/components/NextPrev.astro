---
import { Icon } from 'astro-icon/components';
import { nav } from '../data/site';

const current = Astro.url.pathname;
const index = nav.findIndex((item) => item.href === current);
const prev = index > 0 ? nav[index - 1] : undefined;
const next = index >= 0 && index < nav.length - 1 ? nav[index + 1] : undefined;
---

{
  (prev || next) && (
    <nav aria-label="上一页 / 下一页" class="border-t border-line bg-bg-sunken">
      <div class="shell grid gap-px overflow-hidden py-10 sm:grid-cols-2">
        {prev ? (
          <a
            href={prev.href}
            class="group flex flex-col gap-2 rounded-md p-4 transition-colors duration-200 hover:bg-bg-elev sm:pr-8"
          >
            <span class="flex items-center gap-1.5 font-mono text-[11px] tracking-[0.16em] text-fg-subtle uppercase">
              <Icon
                name="tabler:arrow-left"
                class="size-3.5 transition-transform duration-200 group-hover:-translate-x-0.5"
                aria-hidden="true"
              />
              上一页
            </span>
            <span class="text-[17px] font-medium">{prev.label}</span>
          </a>
        ) : (
          <span aria-hidden="true" />
        )}
        {next && (
          <a
            href={next.href}
            class="group flex flex-col gap-2 rounded-md p-4 text-right transition-colors duration-200 hover:bg-bg-elev sm:pl-8"
          >
            <span class="flex items-center justify-end gap-1.5 font-mono text-[11px] tracking-[0.16em] text-fg-subtle uppercase">
              下一页
              <Icon
                name="tabler:arrow-right"
                class="size-3.5 transition-transform duration-200 group-hover:translate-x-0.5"
                aria-hidden="true"
              />
            </span>
            <span class="text-[17px] font-medium">{next.label}</span>
          </a>
        )}
      </div>
    </nav>
  )
}
