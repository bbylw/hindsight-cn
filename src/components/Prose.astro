---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class:list={['prose-cn', className]}>
  <slot />
</div>

<style>
.prose-cn {
  font-size: 16px;
  min-width: 0;
}

  .prose-cn :global(h2) {
    margin-top: 3.5rem;
    margin-bottom: 1.25rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--color-line-soft);
    font-size: 1.55rem;
    font-weight: 600;
    line-height: 1.35;
    scroll-margin-top: 7rem;
  }

  .prose-cn :global(h2:first-child) {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }

  .prose-cn :global(h3) {
    margin-top: 2.5rem;
    margin-bottom: 0.9rem;
    font-size: 1.2rem;
    font-weight: 600;
    line-height: 1.4;
    scroll-margin-top: 7rem;
  }

  .prose-cn :global(h4) {
    margin-top: 1.75rem;
    margin-bottom: 0.6rem;
    font-size: 1rem;
    font-weight: 600;
  }

  .prose-cn :global(p) {
    margin-top: 1.1rem;
    max-width: 40em;
    line-height: 1.9;
    color: var(--color-fg-muted);
  }

  .prose-cn :global(strong) {
    color: var(--color-fg);
    font-weight: 600;
  }

  .prose-cn :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
    transition: opacity 0.2s;
  }

  .prose-cn :global(a:hover) {
    opacity: 0.8;
  }

  .prose-cn :global(ul),
  .prose-cn :global(ol) {
    margin-top: 1.1rem;
    max-width: 40em;
    padding-left: 1.15rem;
    line-height: 1.9;
    color: var(--color-fg-muted);
  }

  .prose-cn :global(ul) {
    list-style: none;
  }

  .prose-cn :global(ul > li) {
    position: relative;
    margin-top: 0.6rem;
    padding-left: 0.35rem;
  }

  .prose-cn :global(ul > li::before) {
    content: '';
    position: absolute;
    left: -0.85rem;
    top: 0.85em;
    width: 5px;
    height: 5px;
    border-radius: 9999px;
    background: var(--color-accent);
    opacity: 0.65;
  }

  .prose-cn :global(ol) {
    list-style: decimal;
  }

  .prose-cn :global(ol > li) {
    margin-top: 0.6rem;
    padding-left: 0.25rem;
  }

  .prose-cn :global(li > strong:first-child) {
    color: var(--color-fg);
  }

  .prose-cn :global(code) {
    border: 1px solid var(--color-line);
    border-radius: 4px;
    background: var(--color-bg-sunken);
    padding: 0.1em 0.4em;
    font-family: var(--font-mono);
    font-size: 0.855em;
    color: var(--color-fg);
  }

  .prose-cn :global(a code) {
    color: inherit;
  }

  .prose-cn :global(.plain-links a) {
    color: inherit;
    text-decoration: none;
  }

  .prose-cn :global(.plain-links a:hover) {
    opacity: 1;
  }

  .prose-cn :global(blockquote) {
    margin-top: 1.5rem;
    border-left: 2px solid var(--color-accent);
    padding: 0.25rem 0 0.25rem 1.1rem;
    color: var(--color-fg-muted);
  }

  .prose-cn :global(blockquote p) {
    margin-top: 0.6rem;
  }

  .prose-cn :global(blockquote p:first-child) {
    margin-top: 0;
  }

  .prose-cn :global(hr) {
    margin-block: 3rem;
    border: 0;
    border-top: 1px solid var(--color-line);
  }

  .prose-cn :global(table) {
    margin-top: 1.75rem;
    width: 100%;
    border-collapse: collapse;
    font-size: 0.94rem;
  }

  .prose-cn :global(th) {
    border-bottom: 1px solid var(--color-line-strong);
    padding: 0.7rem 0.9rem;
    text-align: left;
    font-weight: 600;
    color: var(--color-fg);
  }

  .prose-cn :global(td) {
    border-bottom: 1px solid var(--color-line);
    padding: 0.8rem 0.9rem;
    color: var(--color-fg-muted);
    vertical-align: top;
  }

  .prose-cn :global(thead th) {
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-fg-subtle);
  }

  .prose-cn :global(.table-wrap) {
    margin-top: 1.75rem;
    overflow-x: auto;
    scrollbar-width: thin;
  }

  .prose-cn :global(.table-wrap > table) {
    margin-top: 0;
  }

  .prose-cn :global(.code-block) {
    margin-top: 1.6rem;
  }
</style>
