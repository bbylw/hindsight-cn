---
import { Code } from 'astro:components';
import type { CodeLanguage } from 'astro';
import { Icon } from 'astro-icon/components';
import CopyButton from './CopyButton.astro';

interface Props {
  code: string;
  lang?: CodeLanguage;
  title?: string;
  class?: string;
}

const { code, lang = 'text', title, class: className = '' } = Astro.props;
---

<div
  data-code
  class:list={['code-panel relative overflow-hidden rounded-lg border border-line', className]}
>
  {
    title && (
      <div class="flex items-center justify-between gap-3 border-b border-line-soft px-4 py-2.5">
        <span class="flex min-w-0 items-center gap-2 text-fg-subtle">
          <Icon name="tabler:file-code" class="size-3.5 shrink-0" aria-hidden="true" />
          <span class="truncate font-mono text-[12.5px]">{title}</span>
        </span>
        <CopyButton />
      </div>
    )
  }
  <div class="flex min-w-0 items-start gap-4 px-4 py-4 sm:px-5 sm:py-[18px]">
    <div class="code-scroll min-w-0 flex-1 overflow-x-auto">
      <Code
        code={code.trim()}
        lang={lang}
        themes={{ light: 'vitesse-light', dark: 'vitesse-dark' }}
        defaultColor={false}
      />
    </div>
    {
      !title && (
        <div class="shrink-0">
          <CopyButton />
        </div>
      )
    }
  </div>
</div>

<style>
  .code-panel {
    min-width: 0;
    background-color: var(--color-bg-sunken);
    box-shadow: inset 0 1px 0 color-mix(in oklab, var(--color-fg) 5%, transparent);
  }

  .code-panel::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      color-mix(in oklab, var(--color-accent) 34%, transparent),
      transparent
    );
  }

  .code-scroll :global(pre.astro-code) {
    min-width: 0;
    max-width: 100%;
    padding: 0 !important;
    background: transparent !important;
    font-size: 13px;
    line-height: 1.78;
  }

  .code-scroll :global(pre.astro-code code) {
    display: block;
    width: max-content;
    min-width: 100%;
  }

  /* 代码横向溢出时保留可见的细滚动条，避免「看不出来能滚」 */
  .code-scroll {
    scrollbar-width: thin;
    scrollbar-color: var(--color-line-strong) transparent;
  }

  .code-scroll::-webkit-scrollbar {
    height: 8px;
  }

  .code-scroll::-webkit-scrollbar-track {
    background: transparent;
  }

  .code-scroll::-webkit-scrollbar-thumb {
    background: var(--color-line-strong);
    border-radius: 99px;
  }
</style>
