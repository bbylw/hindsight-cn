---
import { Icon } from 'astro-icon/components';
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import { site, type NavItem } from '../data/site';

interface Props {
  items: NavItem[];
  current: string;
}

const { items, current } = Astro.props;
const isActive = (href: string) => (href === '/' ? current === '/' : current.startsWith(href));
---

<header
  class="sticky top-0 z-40 border-b border-line-soft bg-bg/80 backdrop-blur-xl supports-[backdrop-filter]:bg-bg/65"
>
  <div class="shell flex h-16 items-center justify-between gap-6">
    <a href="/" class="shrink-0 rounded-md" aria-label="Hindsight 首页">
      <Logo />
    </a>

    <nav aria-label="主导航" class="hidden lg:block">
      <ul class="flex items-center gap-0.5">
        {
          items.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class:list={[
                  'relative block rounded-sm px-3 py-2 text-[14.5px] transition-colors duration-200',
                  isActive(item.href) ? 'text-fg' : 'text-fg-muted hover:text-fg',
                ]}
              >
                {item.label}
                {isActive(item.href) && (
                  <span class="absolute inset-x-3 -bottom-px h-px bg-accent" />
                )}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={site.github}
        target="_blank"
        rel="noreferrer noopener"
        class="hidden size-9 place-items-center rounded-sm border border-line text-fg-muted transition-colors duration-200 hover:border-line-strong hover:text-fg sm:grid"
        aria-label="在 GitHub 上查看源码"
      >
        <Icon name="tabler:brand-github" class="size-4.5" aria-hidden="true" />
      </a>
      <ThemeToggle />
      <a
        href="/quickstart"
        class="hidden rounded-sm bg-accent px-3.5 py-2 text-[14px] font-medium text-accent-fg transition-[transform,background-color] duration-200 hover:bg-accent-strong active:translate-y-px sm:inline-flex"
        >快速开始</a
      >
      <button
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-nav"
        class="grid size-9 place-items-center rounded-sm border border-line text-fg-muted transition-colors duration-200 hover:text-fg lg:hidden"
        aria-label="打开导航菜单"
      >
        <Icon name="tabler:menu-2" class="size-4.5" data-menu-open aria-hidden="true" />
        <Icon name="tabler:x" class="hidden size-4.5" data-menu-close aria-hidden="true" />
      </button>
    </div>
  </div>

  <div id="mobile-nav" hidden class="border-t border-line-soft bg-bg lg:hidden">
    <nav aria-label="移动端导航" class="shell py-4">
      <ul class="grid gap-1">
        {
          items.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class:list={[
                  'flex items-center justify-between rounded-sm px-3 py-2.5 text-[15px] transition-colors duration-200',
                  isActive(item.href)
                    ? 'bg-bg-sunken text-fg'
                    : 'text-fg-muted hover:bg-bg-sunken hover:text-fg',
                ]}
              >
                {item.label}
                <Icon name="tabler:chevron-right" class="size-4 opacity-40" aria-hidden="true" />
              </a>
            </li>
          ))
        }
      </ul>
      <div class="mt-4 flex items-center gap-2 border-t border-line pt-4">
        <a
          href={site.github}
          target="_blank"
          rel="noreferrer noopener"
          class="inline-flex items-center gap-2 rounded-sm border border-line px-3 py-2 text-[14px] text-fg-muted transition-colors duration-200 hover:text-fg"
        >
          <Icon name="tabler:brand-github" class="size-4" aria-hidden="true" />
          GitHub
        </a>
        <a
          href="/quickstart"
          class="inline-flex flex-1 items-center justify-center rounded-sm bg-accent px-3 py-2 text-[14px] font-medium text-accent-fg transition-[transform,background-color] duration-200 hover:bg-accent-strong active:translate-y-px"
          >快速开始</a
        >
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const panel = document.getElementById('mobile-nav');

  if (toggle && panel) {
    const openIcon = toggle.querySelector('[data-menu-open]');
    const closeIcon = toggle.querySelector('[data-menu-close]');

    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!open));
      toggle.setAttribute('aria-label', open ? '打开导航菜单' : '关闭导航菜单');
      panel.hidden = open;
      openIcon?.classList.toggle('hidden', !open);
      closeIcon?.classList.toggle('hidden', open);
    });

    const wide = window.matchMedia('(min-width: 1024px)');
    wide.addEventListener('change', (event) => {
      if (!event.matches) return;
      panel.hidden = true;
      toggle.setAttribute('aria-expanded', 'false');
      openIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
    });
  }
</script>
