---
import { benchmarks } from '../data/site';

const ticks = [0, 25, 50, 75, 100];
const max = 100;
---

<div class="relative">
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    {
      ticks.map((tick) => (
        <span
          class:list={[
            'absolute inset-y-0 w-px',
            tick === 0 || tick === max ? 'bg-line' : 'bg-line-soft',
          ]}
          style={`left:${(tick / max) * 100}%`}
        />
      ))
    }
  </div>

  <ul class="relative grid gap-9">
    {
      benchmarks.map((row) => (
        <li>
          <div class="flex items-baseline justify-between gap-6">
            <span
              class:list={[
                'text-[15px]',
                row.highlight ? 'font-medium text-fg' : 'text-fg-muted',
              ]}
            >
              {row.name}
            </span>
            <span
              class:list={[
                'nums leading-none',
                row.highlight ? 'text-[28px] font-semibold text-accent' : 'text-[17px] text-fg-subtle',
              ]}
            >
              {row.score}%
            </span>
          </div>
          <div class="mt-3.5 h-[3px]">
            <div
              class:list={[
                'h-full rounded-r-full',
                row.highlight
                  ? 'bg-gradient-to-r from-accent to-accent-strong'
                  : 'bg-fg-subtle/60',
              ]}
              style={`width:${(row.score / max) * 100}%`}
            />
          </div>
        </li>
      ))
    }
  </ul>

  <div
    class="nums relative mt-5 flex justify-between text-[11px] text-fg-subtle"
    aria-hidden="true"
  >
    {ticks.map((tick) => <span>{tick}</span>)}
  </div>
</div>
