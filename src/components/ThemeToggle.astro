---
import { Icon } from 'astro-icon/components';
---

<button
  type="button"
  data-theme-toggle
  class="grid size-9 place-items-center rounded-md border border-line text-fg-muted transition-colors duration-200 hover:border-line-strong hover:text-fg active:translate-y-px"
  aria-label="切换浅色 / 深色主题"
>
  <Icon name="tabler:moon" class="size-4.5 dark-only" aria-hidden="true" />
  <Icon name="tabler:sun" class="size-4.5 light-only" aria-hidden="true" />
</button>

<style>
  .dark-only,
  .light-only {
    display: none;
  }

  :global([data-theme='dark']) .dark-only {
    display: block;
  }

  :global([data-theme='light']) .light-only {
    display: block;
  }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]');
  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      const root = document.documentElement;
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {
        /* 隐私模式下忽略 */
      }
    });
  });
</script>
